[
  {
    "id": "search_flights",
    "name": "search_flights",
    "description": "Search for flight offers between two airports on a given date. Returns a short list of offers, each with an offer_id to use with select_flight.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/search_flights",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" },
      { "name": "origin", "type": "string", "description": "Origin airport IATA code, e.g. JFK", "required": true, "location": "body" },
      { "name": "destination", "type": "string", "description": "Destination airport IATA code, e.g. LAX", "required": true, "location": "body" },
      { "name": "departure_date", "type": "string", "description": "Departure date, YYYY-MM-DD", "required": true, "location": "body" },
      { "name": "return_date", "type": "string", "description": "Return date, YYYY-MM-DD, omit for one-way", "required": false, "location": "body" },
      { "name": "adults", "type": "number", "description": "Number of adult travelers, default 1", "required": false, "location": "body" }
    ],
    "timeout": 30,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "select_flight",
    "name": "select_flight",
    "description": "Price-confirm a flight offer returned by search_flights and mark it as the selected flight for this trip.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/select_flight",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" },
      { "name": "offer_id", "type": "string", "description": "offer_id from a prior search_flights result", "required": true, "location": "body" }
    ],
    "timeout": 30,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "search_hotels",
    "name": "search_hotels",
    "description": "Search for hotel offers near a location for a date range. Returns hotels with a hotel_offer_id to use with select_hotel.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/search_hotels",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" },
      { "name": "location_code", "type": "string", "description": "Airport or city code to search around, e.g. NYC", "required": true, "location": "body" },
      { "name": "check_in_date", "type": "string", "description": "Check-in date, YYYY-MM-DD", "required": true, "location": "body" },
      { "name": "check_out_date", "type": "string", "description": "Check-out date, YYYY-MM-DD", "required": true, "location": "body" },
      { "name": "adults", "type": "number", "description": "Number of adult guests, default 1", "required": false, "location": "body" }
    ],
    "timeout": 30,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "select_hotel",
    "name": "select_hotel",
    "description": "Price-confirm a hotel offer returned by search_hotels and mark it as the selected hotel for this trip.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/select_hotel",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" },
      { "name": "hotel_offer_id", "type": "string", "description": "hotel_offer_id from a prior search_hotels result", "required": true, "location": "body" }
    ],
    "timeout": 30,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "search_cars",
    "name": "search_cars",
    "description": "Search for rental car offers for a pickup/return window. Returns cars with a car_offer_id to use with select_car.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/search_cars",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" },
      { "name": "pickup_location_code", "type": "string", "description": "Pickup airport/location code", "required": true, "location": "body" },
      { "name": "dropoff_location_code", "type": "string", "description": "Dropoff location code, defaults to pickup", "required": false, "location": "body" },
      { "name": "pickup_date", "type": "string", "description": "Pickup date, YYYY-MM-DD", "required": true, "location": "body" },
      { "name": "return_date", "type": "string", "description": "Return date, YYYY-MM-DD", "required": true, "location": "body" }
    ],
    "timeout": 30,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "select_car",
    "name": "select_car",
    "description": "Price-confirm a car offer returned by search_cars and mark it as the selected car for this trip.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/select_car",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" },
      { "name": "car_offer_id", "type": "string", "description": "car_offer_id from a prior search_cars result", "required": true, "location": "body" }
    ],
    "timeout": 30,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "set_traveler",
    "name": "set_traveler",
    "description": "Record the lead traveler's name and contact info for this trip. Call before confirm_booking.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/set_traveler",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" },
      { "name": "given_name", "type": "string", "description": "Traveler's first name", "required": true, "location": "body" },
      { "name": "surname", "type": "string", "description": "Traveler's last name", "required": true, "location": "body" },
      { "name": "birth_date", "type": "string", "description": "Date of birth, YYYY-MM-DD", "required": false, "location": "body" },
      { "name": "email", "type": "string", "description": "Contact email", "required": false, "location": "body" },
      { "name": "phone", "type": "string", "description": "Contact phone number", "required": false, "location": "body" }
    ],
    "timeout": 15,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "get_draft_itinerary",
    "name": "get_draft_itinerary",
    "description": "Get a summary of everything currently selected for this trip (flight, hotel, car, cost) before confirming the booking.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/get_draft_itinerary",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" }
    ],
    "timeout": 15,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "confirm_booking",
    "name": "confirm_booking",
    "description": "Book everything currently selected (flight/hotel/car) as one order. This is a real booking — only call after the traveler has explicitly confirmed.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/confirm_booking",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" }
    ],
    "timeout": 60,
    "max_retries": 0,
    "enabled": true
  },
  {
    "id": "get_trip",
    "name": "get_trip",
    "description": "Look up an existing booking by its confirmation id.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/get_trip",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "confirmation_id", "type": "string", "description": "The booking confirmation id / PNR", "required": true, "location": "body" }
    ],
    "timeout": 30,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "cancel_trip",
    "name": "cancel_trip",
    "description": "Cancel an entire existing booking by confirmation id. Only call after the traveler has explicitly confirmed they want to cancel.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/cancel_trip",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "confirmation_id", "type": "string", "description": "The booking confirmation id / PNR", "required": true, "location": "body" }
    ],
    "timeout": 30,
    "max_retries": 0,
    "enabled": true
  },
  {
    "id": "modify_trip",
    "name": "modify_trip",
    "description": "Modify an existing booking (e.g. contact info). changes_json must be a JSON-encoded string of the fields to change.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/modify_trip",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "confirmation_id", "type": "string", "description": "The booking confirmation id / PNR", "required": true, "location": "body" },
      { "name": "changes_json", "type": "string", "description": "JSON-encoded object describing the change", "required": true, "location": "body" }
    ],
    "timeout": 30,
    "max_retries": 0,
    "enabled": true
  },
  {
    "id": "recommend_dining",
    "name": "recommend_dining",
    "description": "Get curated dining recommendations for a destination city.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/recommend_dining",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "city", "type": "string", "description": "Destination city or airport code, e.g. NYC", "required": true, "location": "body" },
      { "name": "cuisine", "type": "string", "description": "Preferred cuisine, optional", "required": false, "location": "body" }
    ],
    "timeout": 15,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "recommend_experiences",
    "name": "recommend_experiences",
    "description": "Get curated activity/experience recommendations for a destination city.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/recommend_experiences",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "city", "type": "string", "description": "Destination city or airport code, e.g. NYC", "required": true, "location": "body" },
      { "name": "interest", "type": "string", "description": "Preferred interest/category, optional", "required": false, "location": "body" }
    ],
    "timeout": 15,
    "max_retries": 1,
    "enabled": true
  },
  {
    "id": "extract_travel_document",
    "name": "extract_travel_document",
    "description": "Extract identity document fields (passport number, name, expiration, etc.) from a photo the traveler just uploaded. Only call after a document_uploaded event has provided a document_url.",
    "method": "POST",
    "url": "https://REPLACE_WITH_YOUR_PUBLIC_BACKEND_URL/tools/extract_travel_document",
    "auth": { "type": "none" },
    "parameters": [
      { "name": "session_id", "type": "string", "description": "The current call's session id", "required": true, "location": "body" },
      { "name": "document_url", "type": "string", "description": "Publicly fetchable URL of the uploaded document photo", "required": true, "location": "body" }
    ],
    "timeout": 45,
    "max_retries": 1,
    "enabled": true
  }
]
