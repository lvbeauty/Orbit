# Server
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Sabre (cert/sandbox)
SABRE_REST_ENDPOINT=https://api.cert.platform.sabre.com
SABRE_SOAP_ENDPOINT=https://webservices.cert.platform.sabre.com
SABRE_API_TOKEN=
# 'bearer' sends "Authorization: Bearer <token>", 'raw' sends "Authorization: <token>"
# Collection declares bearer auth, but example requests show a raw Sabre security token
# with no "Bearer " prefix — verify against a real call and flip if you get 401s.
SABRE_AUTH_HEADER_STYLE=bearer
SABRE_PCC=S5OM

# Vocal Bridge
VOCAL_BRIDGE_API_KEY=
VOCAL_BRIDGE_API_URL=https://vocalbridgeai.com
# Only needed if VOCAL_BRIDGE_API_KEY is an account-level key (not agent-scoped)
VOCAL_BRIDGE_AGENT_ID=

# LandingAI ADE
LANDINGAI_API_KEY=
LANDINGAI_API_URL=https://api.ade.landing.ai
